# Copy this file to `.secrets` (git-ignored) and fill in real tokens.
#
# Used by scripts/publish.sh to upload dreamteam-cli to PyPI.
#
# Generate tokens at:
#   - PyPI:     https://pypi.org/manage/account/token/
#   - TestPyPI: https://test.pypi.org/manage/account/token/  (optional)
#
# For first publication use scope "Entire account"; after the first
# release switch to project-scoped tokens for security.

PYPI_TOKEN=pypi-REPLACE-ME

# Optional — only if you also publish to TestPyPI (scripts/publish.sh --test).
PYPI_TEST_TOKEN=pypi-REPLACE-ME
